{
  "manifest_version": 3,
  "name": "AuraCall — share this Chrome conversation",
  "version": "0.1.0",
  "key": "",
  "description": "Explicitly share an existing ChatGPT or Grok tab with your local AuraCall tools.",
  "permissions": ["debugger", "nativeMessaging", "activeTab"],
  "host_permissions": ["https://chatgpt.com/*", "https://grok.com/*"],
  "background": { "service_worker": "worker.js" },
  "action": { "default_title": "Share or stop sharing this conversation with AuraCall" }
}
